APP_NAME=NewsRadar
ENVIRONMENT=development
PORT=8000
ALLOWED_HOSTS=*
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./data/news.db

# News aggregation
CURRENTS_API_KEY=
CURRENTS_BASE_URL=https://api.currentsapi.services/v1
NEWS_LANGUAGE=en
NEWS_COUNTRY=

# Multi-source tech collectors
ENABLE_GDELT=true
ENABLE_GOOGLE_NEWS_RSS=true
ENABLE_HACKER_NEWS=true
GDELT_TIMESPAN=30min
GDELT_MAXRECORDS=250
NEWSAPI_API_KEY=
GNEWS_API_KEY=
GOOGLE_NEWS_WINDOW=when:30m
OFFICIAL_POLL_MINUTES=5
AGGREGATOR_POLL_MINUTES=10
CURRENTS_POLL_MINUTES=30

# Research / papers
ENABLE_RESEARCH_COLLECTORS=true
RESEARCH_POLL_MINUTES=15
ARXIV_MAX_RESULTS=100
HUGGINGFACE_PAPERS_LIMIT=100
HUGGINGFACE_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_LIMIT=50
OPENALEX_MAILTO=
OPENALEX_LIMIT=100
CROSSREF_LIMIT=100
RESEARCH_GOOGLE_NEWS_WINDOW=when:2h

# Gmail OAuth
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_CLIENT_SECRET_JSON=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.send
NOTIFICATION_RECIPIENT=your-email@example.com

# Cron / scheduler
CRON_TOKEN=replace-with-a-random-cron-token
ENABLE_SCHEDULER=true

# Email relevance
NOTIFICATION_THRESHOLD=5
NOTIFICATION_MODE=instant_digest

# Default tech interests
DEFAULT_KEYWORDS=OpenAI,Google AI,Anthropic,NVIDIA,Microsoft,Meta AI,Apple,Amazon AWS,GitHub,AI,LLM,AI agents,Gemini,Claude,GPT,CUDA,PyTorch,developers,open source,cybersecurity,cloud,kubernetes,robotics,semiconductors,startups

# Morning email digest
NOTIFICATION_MODE=morning_top5
MORNING_DIGEST_LIMIT=5
MORNING_DIGEST_HOURS=24
MORNING_DIGEST_MIN_SCORE=1.0
APP_BASE_URL=http://localhost:8000

# Vercel Cron authentication
CRON_SECRET=
