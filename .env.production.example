# Vercel + Neon production
APP_NAME=NewsRadar
ENVIRONMENT=production
SECRET_KEY=generate-a-long-random-secret
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
ALLOWED_HOSTS=*

# News sources
CURRENTS_API_KEY=
NEWS_LANGUAGE=en
NEWS_COUNTRY=
ENABLE_GDELT=true
ENABLE_GOOGLE_NEWS_RSS=true
ENABLE_HACKER_NEWS=true
NEWSAPI_API_KEY=
GNEWS_API_KEY=

# Research
ENABLE_RESEARCH_COLLECTORS=true
HUGGINGFACE_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=

# Gmail OAuth
# Minified JSON from your Google OAuth Web client. Store this in Vercel as a secret.
GOOGLE_CLIENT_SECRET_JSON={"web":{"client_id":"...","project_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"...","redirect_uris":["https://YOUR-DOMAIN.vercel.app/api/auth/gmail/callback"]}}
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN.vercel.app/api/auth/gmail/callback
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.send
NOTIFICATION_RECIPIENT=you@example.com
APP_BASE_URL=https://YOUR-DOMAIN.vercel.app

# Scheduling / security
# Vercel sends this automatically in Authorization: Bearer ... for Cron Jobs.
CRON_SECRET=generate-another-long-random-secret
# Optional fallback for local/CI calls. Keep the same value if you want one secret everywhere.
CRON_TOKEN=generate-another-long-random-secret
ENABLE_SCHEDULER=false
INITIAL_FETCH_ON_STARTUP=false

# Morning digest
NOTIFICATION_MODE=morning_top5
MORNING_DIGEST_LIMIT=5
MORNING_DIGEST_HOURS=24
MORNING_DIGEST_MIN_SCORE=1.0
